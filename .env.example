# ==========================================================================
# Espetaria PDV - variáveis de ambiente (copie para .env)
# ==========================================================================

# Porta do servidor (API + painel)
PORT=3000

# Segredo dos tokens de sessão. TROQUE em produção:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-em-producao

# --- Banco de dados -------------------------------------------------------
# Deixe DATABASE_URL vazio para usar o PostgreSQL embutido (PGlite):
# nada para instalar, os dados ficam em server/data/pgdata.
# Para usar um PostgreSQL de verdade (Neon, Supabase, Railway, Docker...),
# descomente e ajuste:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/espetaria
# PGSSL=true

# --- IA (opcional) --------------------------------------------------------
# Também pode ser configurado dentro do app em Configurações > Inteligência Artificial.
# Sem chave, o PDV usa o motor de IA local (busca inteligente, sugestões e resumos).
# AI_PROVIDER=openai        # local | openai | gemini | compatible
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=              # para provedores compatíveis com OpenAI (Groq, OpenRouter, Ollama...)

# Popula o banco na primeira execução (mesas, cardápio, usuários e histórico de exemplo)
SEED_DEMO_DATA=true
